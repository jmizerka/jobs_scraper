# Recipient email for matching job offers (used when --email-to is not passed).
EMAIL_TO=you@example.com

# Gmail OAuth 2.0 client secret file (relative to the project root).
GMAIL_CLIENT_SECRET=client_secret_<id>.apps.googleusercontent.com.json

# Where the Gmail OAuth token is stored (relative to the project root).
GMAIL_TOKEN_PATH=token.json
